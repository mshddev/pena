    "@pena/contracts": "workspace:*",
    "better-sqlite3": "^12.11.1",
    "fastify": "^5.10.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.0",
    "tsx": "^4.23.1",
    "vitest": "^4.1.10"
  }
}
