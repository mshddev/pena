{
  "name": "@pena/server",
  "version": "0.0.1",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --build",
    "dev": "tsx watch src/index.ts",
    "pretest": "pnpm --filter @pena/contracts build",
